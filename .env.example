# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Required ----
# Generate with:  openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# ---- Storage ----
# A folder that survives restarts (default: ./data). On your own server use e.g. /var/lib/smart-agriculture
DATA_DIR=

# ---- Weather (optional, free, no API key needed - uses Open-Meteo) ----
LOCATION_LAT=
LOCATION_LON=

# ---- Rover / station integration ----
# Zones and which pump waters them:  zone_id:pump,zone_id:pump
ZONE_PUMP_MAP=1:1,2:2
DEFAULT_CROP=tomato

# SAFE DEFAULT: false = the server only recommends (dry run) and logs. Set to true only after testing.
AUTO_WATER=false

# ThingsBoard (needed only for AUTO_WATER=true and for reading the tank level)
TB_BASE_URL=https://eu.thingsboard.cloud
# Put TB_PASSWORD in "double quotes" if it has spaces or symbols
TB_USERNAME=
TB_PASSWORD=
STATION_DEVICE_NAME="irrigation station"
# Optional: access token of a ThingsBoard device (e.g. "ai_server") that receives AI decisions as telemetry
AI_DEVICE_TOKEN=

# ---- Safety limits (the station enforces its own limits as well) ----
WATER_MIN_SECONDS=5
WATER_MAX_SECONDS=30
WATER_COOLDOWN_S=1800
MAX_READING_AGE_S=900
PLANT_HEALTH_MAX_AGE_S=7200

# ---- Only if a client cannot send the X-API-Key header (not recommended: keys end up in logs) ----
ALLOW_QUERY_API_KEY=false

# ---- Existing options ----
QUALITY_GATE_ENABLED=true
# MACRODROID_DEMO_ON_WEBHOOK_URL=
# MACRODROID_DEMO_OFF_WEBHOOK_URL=

# ---- Local development ONLY (never in production) ----
# DEV_INSECURE_KEY=1
