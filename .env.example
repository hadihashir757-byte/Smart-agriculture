# Copy this file to .env and fill in real values. Never commit the real .env.
API_KEY=change-me-to-a-long-random-string

# Optional - if unset, /get-recommendation just assumes 0mm rain forecast
# and falls back to soil-moisture-only irrigation decisions. No API key
# needed (uses Open-Meteo, which is free and keyless) - just your coordinates.
LOCATION_LAT=
LOCATION_LON=
