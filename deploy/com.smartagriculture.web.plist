<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.smartagriculture.web</string>
  <key>WorkingDirectory</key><string>__HOME__/Smart-agriculture/api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; source __HOME__/Smart-agriculture/.env; set +a; exec __HOME__/Smart-agriculture/venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 60 app:app</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Smart-agriculture/web.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Smart-agriculture/web.log</string>
</dict>
</plist>
